# Placeholder host-side defaults for examples/flowboard/podbay.yaml (mirrors a real Flowboard .env.example).
# Copy to .env and override as needed.

PUBLISH_HTTP_PORT=8081
PUBLISH_HTTPS_PORT=8443
# CADDY_CERTS_VOLUME=./certs

# Ollama: Flowboard’s real .env.example often sets OLLAMA_BASE_URL=http://127.0.0.1:11434 for
# running the API on the host. Podbay host-side substitution would wrongly pass that into the
# container. podbay.yaml sets OLLAMA_BASE_URL from PODBAY_OLLAMA_BASE_URL (default host.docker.internal).
# Uncomment to point at a different host URL from inside Podman:
# PODBAY_OLLAMA_BASE_URL=http://host.docker.internal:11434
